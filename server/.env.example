# Copy this file to .env and fill in real values. See README.md for step-by-step setup.

GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

JWT_SECRET=change-this-to-a-long-random-string

PORT=4000

# Optional: enables real AI notice extraction instead of the rule-based parser.
# Leave blank to use the built-in rule-based extractor (no key needed).
ANTHROPIC_API_KEY=
